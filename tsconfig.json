{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "#trame/kernel": [
        "./trame/kernel.ts"
      ],
      "#trame/kinds/*": [
        "./kinds/*"
      ]
    }
  },
  "include": [
    "trame",
    "kinds",
    "views",
    "engine-views",
    "src"
  ]
}
