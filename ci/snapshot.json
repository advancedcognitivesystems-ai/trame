    {
      "id": "shell.BashScripts",
      "kind": "standard",
      "title": "Bash scripts",
      "fields": {
        "owner": "trame",
        "source": "GNU Bash Reference Manual (5.2): § 3.1.2 Quoting, § 3.2.5 Compound Commands (subshell), § 3.5.3 Shell Parameter Expansion (${parameter:?word}), § 4.3.1 The Set Builtin; env(1) for the #! line",
        "url": "https://www.gnu.org/software/bash/manual/bash.html",
        "constants": {
          "interpreter": {
            "value": "#!/usr/bin/env bash",
            "meaning": "The first line: the script is run by Bash, wherever it is installed"
          },
          "strict": {
            "value": "set -euo pipefail",
            "meaning": "Stops at an unset variable, a command that fails, a pipe whose part fails"
          },
          "comment": {
            "value": "#",
            "meaning": "Opens a comment, to the end of the line"
          },
          "space": {
            "value": " ",
            "meaning": "Separates the words of a command"
          },
          "quote": {
            "value": "\"",
            "meaning": "Around a word that must stay one word"
          },
          "and": {
            "value": "&&",
            "meaning": "Runs the next command only when the one before succeeded"
          },
          "open": {
            "value": "(",
            "meaning": "Opens a subshell: a change of directory in it stays in it"
          },
          "close": {
            "value": ")",
            "meaning": "Closes the subshell"
          },
          "cd": {
            "value": "cd",
            "meaning": "Changes the directory"
          },
          "assign": {
            "value": "=",
            "meaning": "Gives a variable its value"
          },
          "dollar": {
            "value": "$",
            "meaning": "Reads a variable"
          },
          "required": {
            "value": "${1:?",
            "meaning": "Opens the expansion of the first argument that stops the script, saying the rest, when it is missing"
          },
          "closeBrace": {
            "value": "}",
            "meaning": "Closes an expansion"
          },
          "here": {
            "value": "$(dirname \"$0\")",
            "meaning": "The directory of the script, wherever it is run from"
          },
          "separator": {
            "value": "/",
            "meaning": "Between the steps of a path"
          },
          "endOfLine": {
            "value": "\n",
            "meaning": "Ends a line"
          }
        }
      }
    },
    {
      "id": "shell.ShellScript",
      "kind": "syntax",
      "title": "A script of Bash",
      "status": "held",
      "fields": {
        "owner": "trame",
        "section": "§ 3.2.5 Compound Commands; § 3.5.3 Shell Parameter Expansion; § 4.3.1 The Set Builtin",
        "url": "https://www.gnu.org/software/bash/manual/bash.html#Shell-Parameter-Expansion",
        "constants": {
          "person": {
            "value": "by",
            "meaning": "The variable that holds the name of the person who ships"
          },
          "usage": {
            "value": "give the name of the person who ships",
            "meaning": "What the script says when it is run without a name"
          },
          "written": {
            "value": "Written by trame ship from the graph, for the shipment",
            "meaning": "What the script's first comment says"
          },
          "of": {
            "value": "of",
            "meaning": "Between the shipment and its project, in that comment"
          },
          "edit": {
            "value": "Do not edit: edit the graph, then ship.",
            "meaning": "The comment that says where to change it"
          }
        },
        "deps": {
          "standard": "shell.BashScripts",
          "npm": "npm.Npm"
        },
        "write": "(function)",
        "examples": [
          {
            "input": [
              {
                "shipment": "Preview",
                "title": "A preview",
                "project": "apps/poselia",
                "command": [
                  "../../trame.sh",
                  "ship",
                  "Preview",
                  "--by"
                ],
                "file": "apps/poselia/scripts/ship-preview.sh",
                "toRoot": "../../..",
                "installs": [
                  ".",
                  "std",
                  "apps/poselia"
                ],
                "prepares": [
                  {
                    "dir": "std",
                    "run": "npx playwright install --with-deps chromium"
                  }
                ],
                "delivers": [
                  {
                    "artifact": "PageFile",
                    "path": "apps/poselia/dist/poselia.html"
                  }
                ],
                "evidence": "apps/poselia/evidence",
                "deployed": {
                  "command": [
                    "../../trame.sh",
                    "evidence"
                  ],
                  "verdict": "passed",
                  "by": "--by",
                  "url": "--url"
                }
              }
            ],
            "output": "#!/usr/bin/env bash\n# Written by trame ship from the graph, for the shipment \"A preview\" of apps/poselia\n# Do not edit: edit the graph, then ship.\nset -euo pipefail\nby=\"${1:?give the name of the person who ships}\"\ncd \"$(dirname \"$0\")/../../..\"\n(cd \".\" && npm ci)\n(cd \"std\" && npm ci)\n(cd \"apps/poselia\" && npm ci)\n(cd \"std\" && npx playwright install --with-deps chromium)\ncd \"apps/poselia\"\n../../trame.sh ship Preview --by \"$by\"\n"
          }
        ]
      }
