          "dash": {
            "value": "-",
            "meaning": "Opens an entry of a block sequence (§ 8.2.1)"
          },
          "literal": {
            "value": "|",
            "meaning": "Opens a literal block: the lines under it, deeper, are kept as they are (§ 8.1.2)"
          },
          "comment": {
