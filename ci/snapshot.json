{
  "at": "2026-10-31",
  "nodes": [
    {
      "id": "github.GitHubActions",
      "kind": "standard",
      "title": "GitHub Actions",
      "fields": {
        "owner": "trame",
        "source": "GitHub Docs, Workflow syntax for GitHub Actions; Contexts reference (github.actor, steps.<id>.outputs); Expressions (always()); actions/upload-artifact v4, outputs (artifact-url)",
        "url": "https://docs.github.com/en/actions/writing-workflows/workflow-syntax-for-github-actions",
        "constants": {
          "name": {
            "value": "name",
            "meaning": "The name of the workflow, or of what an action uploads"
          },
          "on": {
            "value": "on",
            "meaning": "What starts the workflow"
          },
          "manual": {
            "value": "workflow_dispatch",
            "meaning": "Started by hand, from GitHub"
          },
          "push": {
            "value": "push",
            "meaning": "Started by a push"
          },
          "branches": {
            "value": "branches",
            "meaning": "The branches a push starts it on"
          },
          "tags": {
            "value": "tags",
            "meaning": "The tags a push starts it on"
          },
          "schedule": {
            "value": "schedule",
            "meaning": "Started at the times a cron expression gives (UTC)"
          },
          "cron": {
            "value": "cron",
            "meaning": "The cron expression of a schedule"
          },
          "permissions": {
            "value": "permissions",
            "meaning": "What the workflow's token may do"
          },
          "contents": {
            "value": "contents",
            "meaning": "The repository's contents"
          },
          "read": {
            "value": "read",
            "meaning": "Read only"
          },
          "jobs": {
            "value": "jobs",
            "meaning": "The jobs of the workflow, by their names"
          },
          "runsOn": {
            "value": "runs-on",
            "meaning": "The machine a job runs on"
          },
          "steps": {
            "value": "steps",
            "meaning": "The steps of a job, in order"
          },
          "uses": {
            "value": "uses",
            "meaning": "The action a step uses"
          },
          "with": {
            "value": "with",
            "meaning": "What the action is given"
          },
          "run": {
            "value": "run",
            "meaning": "The command a step runs"
          },
          "workingDirectory": {
            "value": "working-directory",
            "meaning": "Where the command of a step runs, from the repository's root"
          },
          "when": {
            "value": "if",
            "meaning": "The condition a step runs on"
          },
          "always": {
            "value": "always()",
            "meaning": "Whatever the steps before answered: what keeps the evidence of a shipment refused"
          },
          "nodeVersion": {
            "value": "node-version",
            "meaning": "The version of Node.js setup-node installs"
          },
          "path": {
            "value": "path",
            "meaning": "What upload-artifact keeps, one path a line"
          },
          "retentionDays": {
            "value": "retention-days",
            "meaning": "How many days GitHub keeps what upload-artifact uploaded"
          },
          "id": {
            "value": "id",
            "meaning": "The name of a step, by which a later step reads what it gives"
          },
          "actor": {
            "value": "${{ github.actor }}",
            "meaning": "The person who started the workflow"
          },
          "openExpression": {
            "value": "${{ ",
            "meaning": "Opens an expression, which GitHub replaces before the step runs"
          },
          "closeExpression": {
            "value": " }}",
            "meaning": "Closes it"
          },
          "outputs": {
            "value": "outputs",
            "meaning": "What a step gives, read as steps.<id>.outputs.<name>"
          },
          "dot": {
            "value": ".",
            "meaning": "Between the parts of a context's path"
          },
          "artifactUrl": {
            "value": "artifact-url",
            "meaning": "What upload-artifact (v4) gives: the address of the artefact it uploaded"
          }
        }
      }
    },
    {
      "id": "github.GitHubWorkflow",
      "kind": "syntax",
      "title": "A workflow of GitHub Actions",
      "status": "held",
      "fields": {
        "owner": "trame",
        "section": "Workflow syntax: on, permissions, jobs.<job_id>.runs-on, jobs.<job_id>.steps[*].uses, with, run, working-directory, if",
        "url": "https://docs.github.com/en/actions/writing-workflows/workflow-syntax-for-github-actions",
        "constants": {
          "job": {
            "value": "ship",
            "meaning": "The name of the one job"
          },
          "delivered": {
            "value": "delivered",
            "meaning": "The name of the step that uploads what the shipment ships, whose address is recorded after it"
          },
          "evidence": {
            "value": "evidence",
            "meaning": "After the shipment's name: the name of the artefact that keeps its evidence"
          },
          "joint": {
            "value": "-",
            "meaning": "Between the shipment's name and that word"
          },
          "space": {
            "value": " ",
            "meaning": "Separates the words of a command"
          },
          "quote": {
            "value": "\"",
            "meaning": "Around the person's name, given to the shell as one word"
          },
          "written": {
            "value": "Written by trame ship from the graph, for the shipment",
            "meaning": "What the workflow's first comment says"
          },
          "of": {
            "value": "of",
            "meaning": "Between the shipment and its project, in that comment"
          },
          "edit": {
            "value": "Do not edit: edit the graph, then ship.",
            "meaning": "The comment that says where to change it"
          }
        },
        "deps": {
          "standard": "github.GitHubActions",
          "yaml": "yaml.YamlDocument",
          "npm": "npm.Npm",
          "actions": "github.PinnedActions"
        },
        "write": "(function)",
        "examples": [
          {
            "input": [
              {
                "shipment": "Preview",
                "title": "A preview",
                "project": "apps/poselia",
                "command": [
                  "../../trame.sh",
                  "ship",
                  "Preview",
                  "--by"
                ],
                "file": ".github/workflows/poselia-preview.yml",
                "toRoot": "../..",
                "installs": [
                  ".",
                  "std",
                  "apps/poselia"
                ],
                "prepares": [
                  {
                    "dir": "std",
                    "run": "npx playwright install --with-deps chromium"
                  }
                ],
                "delivers": [
                  {
                    "artifact": "PageFile",
                    "path": "apps/poselia/dist/poselia.html"
                  }
                ],
                "evidence": "apps/poselia/evidence",
                "deployed": {
                  "command": [
                    "../../trame.sh",
                    "evidence"
                  ],
                  "verdict": "passed",
                  "by": "--by",
                  "url": "--url"
                }
              },
              {
                "on": {
                  "manual": true,
                  "branches": [
                    "main"
                  ]
                },
                "runsOn": "ubuntu-24.04",
                "node": 22,
                "artefacts": {
                  "days": 30,
                  "evidence": {
                    "days": 90
                  }
                }
              }
            ],
            "output": "# Written by trame ship from the graph, for the shipment \"A preview\" of apps/poselia\n# Do not edit: edit the graph, then ship.\nname: A preview\non:\n  workflow_dispatch:\n  push:\n    branches:\n      - main\npermissions:\n  contents: read\njobs:\n  ship:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n      - run: npm ci\n        working-directory: \".\"\n      - run: npm ci\n        working-directory: std\n      - run: npm ci\n        working-directory: apps/poselia\n      - run: npx playwright install --with-deps chromium\n        working-directory: std\n      - run: \"../../trame.sh ship Preview --by \\\"${{ github.actor }}\\\"\"\n        working-directory: apps/poselia\n      - id: delivered\n        uses: actions/upload-artifact@v4\n        with:\n          name: Preview\n          path: |\n            apps/poselia/dist/poselia.html\n          retention-days: 30\n      - run: \"../../trame.sh evidence PageFile passed --by \\\"${{ github.actor }}\\\" --url \\\"${{ steps.delivered.outputs.artifact-url }}\\\"\"\n        working-directory: apps/poselia\n      - uses: actions/upload-artifact@v4\n        if: \"always()\"\n        with:\n          name: Preview-evidence\n          path: apps/poselia/evidence\n          retention-days: 90\n"
          },
          {
            "input": [
              {
                "shipment": "Preview",
                "title": "A preview",
                "project": ".",
                "command": [
                  "./trame.sh",
                  "ship",
                  "Preview",
                  "--by"
                ],
                "file": ".github/workflows/preview.yml",
                "toRoot": "../..",
                "installs": [
                  "."
                ],
                "prepares": [],
                "delivers": [],
                "evidence": "evidence",
                "deployed": {
                  "command": [
                    "./trame.sh",
                    "evidence"
                  ],
                  "verdict": "passed",
                  "by": "--by",
                  "url": "--url"
                }
              },
              {
                "on": {
                  "schedule": "0 6 * * 1"
                },
                "runsOn": "ubuntu-24.04",
                "node": 22,
                "artefacts": {
                  "days": 30
                }
              }
            ],
            "output": "# Written by trame ship from the graph, for the shipment \"A preview\" of .\n# Do not edit: edit the graph, then ship.\nname: A preview\non:\n  schedule:\n    - cron: \"0 6 * * 1\"\npermissions:\n  contents: read\njobs:\n  ship:\n    runs-on: ubuntu-24.04\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 22\n      - run: npm ci\n        working-directory: \".\"\n      - run: \"./trame.sh ship Preview --by \\\"${{ github.actor }}\\\"\"\n        working-directory: \".\"\n"
          }
        ]
      }
    },
    {
      "id": "github.PinnedActions",
      "kind": "decision",
      "title": "The actions a workflow uses",
      "fields": {
        "owner": "trame",
        "value": {
          "checkout": "actions/checkout@v4",
          "setupNode": "actions/setup-node@v4",
          "upload": "actions/upload-artifact@v4"
        },
        "rejected": {
          "Pinned by the commit": "a moved tag could not change them, but a review reads a hash; a later decision, when a project ships to the public",
          "The latest version": "a workflow would change without the graph changing"
        }
      }
    },
