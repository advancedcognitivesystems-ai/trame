      "id": "sdlc.PullRequestsOnGitHub",
      "kind": "decision",
      "title": "How a pull request is checked on GitHub",
      "fields": {
        "owner": "trame",
        "value": {
          "on": {
            "pullRequests": [
              "main"
            ]
          },
          "job": "commands",
          "runsOn": "ubuntu-24.04",
          "node": 22,
          "artefacts": {
            "days": 30
          },
          "pullRequest": {
            "review": false,
            "merge": "onceItHoldsUnlessDecided"
          }
        },
        "rejected": {
          "Only when a pull request touches the project": "GitHub keeps a pull request waiting for a check it requires and that never ran",
          "Merged by GitHub whatever it changes": "what people decided would reach main without a person"
        }
